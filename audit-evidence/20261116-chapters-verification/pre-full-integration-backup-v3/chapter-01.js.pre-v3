  keyTerms: [
    { term: "ADT", definition: "A data type defined by its values and operations, independent of implementation." },
    { term: "Data structure", definition: "A concrete organization of data in memory, including the operations that manipulate it." },
    { term: "T(n)", definition: "The running time (or operation count) as a function of input size n." },
    { term: "O(f(n))", definition: "Upper bound: T(n) ≤ c·f(n) beyond some n₀." },
    { term: "Ω(g(n))", definition: "Lower bound: T(n) ≥ c·g(n) beyond some n₀." },
    { term: "Θ(h(n))", definition: "Tight bound: both O(h(n)) and Ω(h(n))." },
    { term: "Basic operation", definition: "An operation whose cost does not depend on the particular operand values." },
    { term: "Overhead", definition: "Extra space a structure stores to support efficient access (links, metadata, capacity)." }
  ],
