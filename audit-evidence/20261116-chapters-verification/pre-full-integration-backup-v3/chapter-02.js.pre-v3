        { type: "h3", text: "The complete source trace" },
        { type: "p", text: "Starting from `9, 6, 2, 12, 11, 9, 3, 7`, the slides walk through every comparison. The table condenses the result of each pass." },
        { type: "table", caption: "Bubble sort on the slide array (source pp. 17–24)", head: ["Pass", "Array after the pass", "Comparisons", "What became final"], rows: [
          ["0 (start)", "`9 6 2 12 11 9 3 7`", "—", "—"],
          ["1", "`6 2 9 11 9 3 7 12`", "7", "12"],
          ["2", "`2 6 9 9 3 7 11 12`", "6", "11"],
          ["3", "`2 6 9 3 7 9 11 12`", "5", "9 (one of the two 9s)"],
          ["4", "`2 6 3 7 9 9 11 12`", "4", "9"],
          ["5", "`2 3 6 7 9 9 11 12`", "3", "7"],
          ["6", "`2 3 6 7 9 9 11 12`", "2", "no exchanges → stop"]
        ] },
        { type: "p", text: "Pass 1 in detail: 9↔6, 6↔2, then 9 < 12 so no exchange, 12↔11, 12↔9, 12↔3, 12↔7. The `12` ends at the last index. Pass 2 stops before the last element, because the last element is already final. Each pass therefore requires one fewer comparison." },
        { type: "code", title: "Bubble sort with the no-exchange early exit", language: "cpp", verified: "MSVC 19.44 · /std:c++17 /EHsc", code: String.raw`#include <iostream>
#include <utility>
#include <vector>

void print(const std::vector<int>& a) {
    for (int value : a) std::cout << value << ' ';
    std::cout << '\n';
}

void bubble_sort(std::vector<int>& a) {
    const std::size_t n = a.size();
    for (std::size_t pass = 0; pass + 1 < n; ++pass) {
        bool swapped = false;
        // The last 'pass' elements are already in final position.
        for (std::size_t j = 0; j + 1 < n - pass; ++j) {
            if (a[j] > a[j + 1]) {
                std::swap(a[j], a[j + 1]);
                swapped = true;
            }
        }
        std::cout << "after pass " << (pass + 1) << ": ";
        print(a);
        if (!swapped) {
            std::cout << "no exchanges -> sorted\n";
            break;
        }
    }
}

int main() {
    std::vector<int> data{9, 6, 2, 12, 11, 9, 3, 7};
    std::cout << "start:         ";
    print(data);
    bubble_sort(data);
}` },
        { type: "code", title: "Actual output", language: "text", code: String.raw`start:         9 6 2 12 11 9 3 7
