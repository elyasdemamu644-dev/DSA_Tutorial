        { type: "callout", tone: "info", title: "A sorting-plus-searching decision", text: "If you will search the same collection many times, sorting once to unlock O(log n) search can pay for itself. If you search once, sorting first may cost more than a single O(n) linear scan." },
        { type: "h3", text: "Worked comparison: 32 unsorted items" },
