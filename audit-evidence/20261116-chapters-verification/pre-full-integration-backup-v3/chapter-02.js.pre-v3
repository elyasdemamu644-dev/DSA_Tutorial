    {
      id: "binary-search",
      title: "Binary search",
      pages: "Slides 31–43; supplement pp. 5–10",
      blocks: [
        { type: "p", text: "Binary search is like looking up a word in a dictionary: start in the middle, then keep the half that can contain the target. It requires the array to be **sorted**. Inspect the middle element; if it is the key, stop. If the key is smaller, continue in the left half; if larger, continue in the right half." },
        { type: "p", text: "On each step, compute `mid = (low + high) / 2`, compare `A[mid]` with the key, and move either `low` or `high` inward. The loop stops when the key is found, or when `low > high`, which means the search space is empty." },
        { type: "h3", text: "Successful search: 44" },
        { type: "table", caption: "Array [5, 12, 17, 23, 38, 44, 77, 84, 90], indices 0–8 (source pp. 34–36)", head: ["Step", "low", "high", "mid", "A[mid]", "Decision"], rows: [
          ["1", "0", "8", "4", "38", "38 < 44 → low = 5"],
          ["2", "5", "8", "6", "77", "44 < 77 → high = 5"],
          ["3", "5", "5", "5", "44", "44 == 44 → found at index 5"]
        ] },
        { type: "h3", text: "Unsuccessful search: 45" },
        { type: "table", caption: "The same array, searching for an absent key (source pp. 37–40)", head: ["Step", "low", "high", "mid", "A[mid]", "Decision"], rows: [
          ["1", "0", "8", "4", "38", "38 < 45 → low = 5"],
          ["2", "5", "8", "6", "77", "45 < 77 → high = 5"],
          ["3", "5", "5", "5", "44", "44 < 45 → low = 6"],
          ["4", "6", "5", "—", "—", "low > high → not found"]
        ] },
        { type: "code", title: "Iterative and recursive binary search", language: "cpp", verified: "MSVC 19.44 · /std:c++17 /EHsc", code: String.raw`#include <iostream>
#include <string>
#include <vector>

// Iterative version. Returns the index, or -1 if the key is absent.
int binary_search(const std::vector<int>& a, int key, int& comparisons) {
    int low = 0;
    int high = static_cast<int>(a.size()) - 1;
    comparisons = 0;

    while (low <= high) {
        int mid = low + (high - low) / 2;   // avoids low + high overflow
        ++comparisons;
        if (a[mid] == key) {
            return mid;
        } else if (a[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1;
}

int helper(const std::vector<int>& a, int low, int high, int key, int& comparisons) {
    if (low > high) {
        return -1;
    }
    int mid = low + (high - low) / 2;
    ++comparisons;
    if (a[mid] == key) return mid;
    if (a[mid] < key) return helper(a, mid + 1, high, key, comparisons);
    return helper(a, low, mid - 1, key, comparisons);
}

int binary_search_recursive(const std::vector<int>& a, int key, int& comparisons) {
    comparisons = 0;
    return helper(a, 0, static_cast<int>(a.size()) - 1, key, comparisons);
}

int main() {
    const std::vector<int> data{5, 12, 17, 23, 38, 44, 77, 84, 90};

    for (int key : {44, 45}) {
        int iterative_comparisons = 0;
        int recursive_comparisons = 0;
        int i1 = binary_search(data, key, iterative_comparisons);
        int i2 = binary_search_recursive(data, key, recursive_comparisons);
        std::cout << "search(" << key << "): "
                  << (i1 == -1 ? "not found" : "index " + std::to_string(i1))
                  << ", iterative comparisons=" << iterative_comparisons
                  << ", recursive comparisons=" << recursive_comparisons
                  << ", recursive index=" << i2 << '\n';
    }
}` },
        { type: "code", title: "Actual output", language: "text", code: String.raw`search(44): index 5, iterative comparisons=3, recursive comparisons=3, recursive index=5
search(45): not found, iterative comparisons=3, recursive comparisons=3, recursive index=-1` },
        { type: "h3", text: "Why O(log n)?" },
        { type: "p", text: "After one bisection, at most N/2 items remain; after two, N/4 = N/2²; after i bisections, N/2ⁱ. The search space collapses to one item when N/2ⁱ = 1, so i = log₂ N. The worst case is therefore O(log n)." },
        { type: "table", caption: "Binary search cases (supplement p. 9)", head: ["Case", "Input", "Bound"], rows: [
          ["Best", "Target is the first inspected middle element", "O(1)"],
          ["Worst", "Target is absent", "O(log n)"],
          ["Average", "Statistical analysis beyond this course", "O(log n)"]
        ] },
        { type: "callout", tone: "warn", title: "Precondition first", text: "Binary search on unsorted data is meaningless: the comparison tells you which half *would* contain the key only if the array is sorted. If the data is unsorted, you must sort it first — and the sort may cost more than the search saves." },
        { type: "note", text: "The source’s iterative code prints “found at position” but does not return; the cleaned version returns the index so it can be tested. The recursive version follows the supplement’s pseudocode (pp. 10)." }
      ]
