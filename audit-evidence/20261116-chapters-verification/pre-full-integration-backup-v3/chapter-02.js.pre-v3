      blocks: [
        { type: "p", text: "Linear search checks the elements one by one, in sequence, until the desired result is found or the list ends. It is the most natural way to search and works on unsorted data." },
        { type: "p", text: "The daily-life example from the slides: to find the person with phone number “1234” in a telephone directory sorted by **name**, you cannot jump to a likely page. You must go through the numbers one at a time." },
        { type: "p", text: "The search method looks for a **key** passed as a parameter and returns the index of the matching element, or −1 if unsuccessful." },
        { type: "code", title: "Linear search — returns the index or -1", language: "cpp", verified: "MSVC 19.44 · /std:c++17 /EHsc", code: String.raw`#include <iostream>
#include <string>
#include <vector>

int linear_search(const std::vector<int>& data, int key) {
    for (std::size_t i = 0; i < data.size(); ++i) {
        if (data[i] == key) {
            return static_cast<int>(i);   // found: return the index
        }
    }
    return -1;                            // not found
}

int main() {
    const std::vector<int> data{4, 18, 7, 23, 9, 41};

    int key = 23;
    int pos = linear_search(data, key);
    std::cout << "search(" << key << ") -> "
              << (pos == -1 ? "not found" : "index " + std::to_string(pos))
              << '\n';

    key = 5;
    pos = linear_search(data, key);
    std::cout << "search(" << key << ") -> "
              << (pos == -1 ? "not found" : "index " + std::to_string(pos))
              << '\n';
}` },
        { type: "code", title: "Actual output", language: "text", code: String.raw`search(23) -> index 3
search(5) -> not found` },
        { type: "h3", text: "Cost" },
        { type: "table", caption: "Linear search (source pp. 27–29, 53)", head: ["Case", "Input", "Comparisons", "Bound"], rows: [
