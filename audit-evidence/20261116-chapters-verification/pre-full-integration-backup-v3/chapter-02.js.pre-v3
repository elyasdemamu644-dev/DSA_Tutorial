        { type: "p", text: "The loop runs from i = 0 to n−1. At position i, find the smallest element in the range i..n−1, then swap it with the value at position i. The prefix 0..i is sorted after the swap." },
        { type: "table", caption: "Trace of the source example [1, 3, 2, 9, 6, 4, 8]", head: ["i", "Smallest in i..n−1", "Action", "Array after pass"], rows: [
          ["0", "1 at index 0", "swap with itself", "`1 3 2 9 6 4 8`"],
          ["1", "2 at index 2", "swap 3 ↔ 2", "`1 2 3 9 6 4 8`"],
          ["2", "3 at index 2", "swap with itself", "`1 2 3 9 6 4 8`"],
          ["3", "4 at index 5", "swap 9 ↔ 4", "`1 2 3 4 6 9 8`"],
          ["4", "6 at index 4", "swap with itself", "`1 2 3 4 6 9 8`"],
          ["5", "8 at index 6", "swap 9 ↔ 8", "`1 2 3 4 6 8 9`"],
          ["6", "9 at index 6", "swap with itself", "`1 2 3 4 6 8 9`"]
        ] },
        { type: "code", title: "Selection sort — cleaned-up C++17 version of the slide code", language: "cpp", verified: "MSVC 19.44 · /std:c++17 /EHsc", code: String.raw`#include <iostream>
#include <utility>
#include <vector>

void print(const std::vector<int>& a) {
    for (int value : a) std::cout << value << ' ';
    std::cout << '\n';
}

void selection_sort(std::vector<int>& a) {
    for (std::size_t i = 0; i < a.size(); ++i) {
        std::size_t smallest = i;              // assume a[i] is smallest
        for (std::size_t j = i + 1; j < a.size(); ++j) {
            if (a[j] < a[smallest]) {
                smallest = j;
            }
        }
        std::swap(a[smallest], a[i]);          // place minimum at i
        std::cout << "after pass " << (i + 1) << ": ";
        print(a);
    }
}

int main() {
    std::vector<int> data{1, 3, 2, 9, 6, 4, 8};
    std::cout << "start:         ";
    print(data);
    selection_sort(data);
}` },
        { type: "code", title: "Actual output", language: "text", code: String.raw`start:         1 3 2 9 6 4 8
