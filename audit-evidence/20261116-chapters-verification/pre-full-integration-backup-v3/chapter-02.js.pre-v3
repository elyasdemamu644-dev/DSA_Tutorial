      blocks: [
        { type: "p", text: "Insertion sort keeps two groups: a **sorted** group and an **unsorted** group. Pick an item from the unsorted group and insert it at the right position in the sorted group, shifting larger items to the right to make room. Repeat until the unsorted group is empty." },
        { type: "h3", text: "The card-sorting trace (source p. 7)" },
        { type: "p", text: "The vertical bar separates the sorted prefix from the unsorted suffix:" },
        { type: "table", head: ["Step", "Array"], rows: [
          ["Start", "`8 | 5 9 2 6 3`"],
          ["Insert 5", "`5 8 | 9 2 6 3`"],
          ["Insert 9", "`5 8 9 | 2 6 3`"],
          ["Insert 2", "`2 5 8 9 | 6 3`"],
          ["Insert 6", "`2 5 6 8 9 | 3`"],
          ["Insert 3", "`2 3 5 6 8 9 |`"]
        ] },
        { type: "p", text: "The first value is sorted relative to itself. For each later value, remove it, slide larger sorted values one position right, and place it in the gap. After pass i, the first i+1 positions hold the original elements in sorted order." },
        { type: "h3", text: "C++17 implementation" },
        { type: "code", title: "Insertion sort with a pass-by-pass trace", language: "cpp", verified: "MSVC 19.44 · /std:c++17 /EHsc", code: String.raw`#include <iostream>
#include <vector>

void print(const std::vector<int>& a) {
    for (int value : a) std::cout << value << ' ';
    std::cout << '\n';
}

void insertion_sort(std::vector<int>& a) {
    for (std::size_t i = 1; i < a.size(); ++i) {
        int key = a[i];              // remove a[i]
        std::size_t j = i;
        while (j > 0 && a[j - 1] > key) {
            a[j] = a[j - 1];         // slide larger value right
            --j;
        }
        a[j] = key;                  // insert into the gap
        std::cout << "after pass " << i << ": ";
        print(a);
    }
}

int main() {
    std::vector<int> data{8, 5, 9, 2, 6, 3};
    std::cout << "start:          ";
    print(data);
    insertion_sort(data);
    std::cout << "sorted:         ";
    print(data);
}` },
        { type: "code", title: "Actual output", language: "text", code: String.raw`start:          8 5 9 2 6 3
after pass 1: 5 8 9 2 6 3
after pass 2: 5 8 9 2 6 3
after pass 3: 2 5 8 9 6 3
after pass 4: 2 5 6 8 9 3
after pass 5: 2 3 5 6 8 9
sorted:         2 3 5 6 8 9` },
