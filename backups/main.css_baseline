/* Main CSS Styles for DSA Tutor Web Interface */

:root {
    --primary-color: #2c3e50;
    --secondary-color: #3498db;
    --accent-color: #e74c3c;
    --background-color: #f4f7f6;
    --text-color: #333333;
    --card-background: #ffffff;
    --border-color: #ddd;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
    background-color: var(--background-color);
    color: var(--text-color);
    line-height: 1.6;
}

header {
    background-color: var(--primary-color);
    color: white;
    padding: 1.5rem 0;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

header .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    font-size: 1.8rem;
}

header p {
    font-size: 1rem;
    opacity: 0.9;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 20px;
}

nav a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
    padding: 10px 15px;
    border-radius: 4px;
}

nav a:hover {
    color: var(--secondary-color);
    background-color: rgba(52, 152, 219, 0.1);
}

main {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 20px;
}

.content-area {
    background: var(--card-background);
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    min-height: 400px;
}

.content-area h2 {
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-color);
}

.content-area p {
    margin-bottom: 1rem;
    color: #666;
}

/* Responsive */
@media (max-width: 768px) {
    nav ul {
        flex-direction: column;
        gap: 10px;
    }
    
    header .container {
        flex-direction: column;
        gap: 1rem;
    }
    
    header h1 {
        font-size: 1.5rem;
    }
}
